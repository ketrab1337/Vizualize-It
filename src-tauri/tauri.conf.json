{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vizualize It",
  "version": "0.1.13",
  "identifier": "com.vizualizeit.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Vizualize It",
        "width": 1400,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 700,
        "maximized": true,
        "decorations": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: tauri:; connect-src ipc: http://ipc.localhost http://tauri.localhost https:;"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ketrab1337/Vizualize-It/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCQUNDN0ZBQjYxM0QzQzkKUldUSjB4TzIrc2VzSzlkRVlHNTZBbmN4Vm93dmc5L1lCc3VnaXRjdElTYTIrK1ZYdHdTV2FSUmYK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/installer.ico",
        "languages": ["Polish"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
